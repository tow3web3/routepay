[Unit]
Description=ROUTEPAY Telegram bot + scheduler + API (Robinhood Chain)
After=network.target postgresql.service

[Service]
WorkingDirectory=/root/routepay/backend
EnvironmentFile=/root/routepay/backend/.env
Environment=NODE_ENV=production
Environment=PORT=5400
ExecStart=/usr/bin/node /root/routepay/backend/src/index.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
